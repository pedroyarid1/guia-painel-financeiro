# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Fonte dos dados: mock (fictícios, padrão para desenvolver e testar) ou pluggy (seus bancos pelo Meu Pluggy)
DATA_SOURCE=mock

# Pluggy (só para DATA_SOURCE=pluggy). Client ID e Secret da aplicação criada em dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# itemIds copiados da página Demo do Dashboard (Connected Items), um por banco, separados por vírgula
PLUGGY_ITEM_IDS=
# Data em que você autorizou o MeuPluggy (AAAA-MM-DD); a autorização vale 1 ano
PLUGGY_AUTHORIZED_AT=

# Pasta do banco SQLite (padrão: local-data, fora do git).
# Recomendação: use local-data para mock e local-data/real para pluggy, para nunca misturar dados fictícios e reais.
DATA_DIR=local-data
# Porta do servidor local (escuta apenas em 127.0.0.1)
PORT=5174

# Pasta de destino do backup (npm run backup), ex.: uma pasta sincronizada com Google Drive, OneDrive ou iCloud
BACKUP_DIR=
